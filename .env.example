OPENAI_API_KEY=blabla
ANTHROPIC_API_KEY=blabla

port=5432
database=postgres
host=localhost
user=postgres
password=postgres
JWT_SECRET=

# Agent SQL reads these only. Point them at a read replica and a SELECT-only role.
ANALYTICS_HOST=localhost
ANALYTICS_PORT=5432
ANALYTICS_USER=querymesh_ro
ANALYTICS_PASSWORD=
ANALYTICS_DATABASE=postgres
ANALYTICS_SSLMODE=

# Required for the ETL worker (python -m workers.etl_worker). Empty keeps an in-process queue.
REDIS_URL=redis://localhost:6379/0
ETL_URL_ALLOWLIST=https://pokeapi.co/
RATE_LIMIT_USER=30
RATE_LIMIT_TENANT=120
RATE_LIMIT_WINDOW_SECONDS=60
ETL_TIMEOUT_SECONDS=20
ETL_MEMORY_MB=512

# Phase 4: model routing, budgets, schema RAG, caches
LLM_LOW=gpt-4o-mini
LLM_MEDIUM=gpt-4o
LLM_HIGH=claude-sonnet-4-5
MAX_TOKENS=8000
MAX_AGENT_STEPS=8
MAX_GRAPH_STEPS=16
SCHEMA_RAG_K=4
SCHEMA_CACHE_TTL=120
ANSWER_CACHE_TTL=60
SQL_APPROVAL_LIMIT=1000
LLM_COST_PER_1K_INPUT=0.00015
LLM_COST_PER_1K_OUTPUT=0.0006

# Phase 5: traces, metrics, retries, audit
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=
LANGCHAIN_PROJECT=querymesh
LLM_TIMEOUT_SECONDS=30
LLM_RETRIES=2
LLM_FALLBACK=gpt-4o-mini
DB_RETRIES=2
RETRY_BASE_SECONDS=0.2
CIRCUIT_FAILURES=5
CIRCUIT_COOLDOWN_SECONDS=30
SQL_STATEMENT_TIMEOUT_MS=5000
AUDIT_LOG_PATH=data/audit.jsonl
FEEDBACK_LOG_PATH=data/feedback.jsonl

# local | production. production refuses a baked-in .env and placeholder secrets.
QUERYMESH_ENV=local
# Directory of secret files (one file per env name), mounted from a secret manager.
QUERYMESH_SECRETS_DIR=